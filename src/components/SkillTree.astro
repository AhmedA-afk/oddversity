---
import { tracks, roleTracks, groups as groupNames, type NodeStatus } from '../data/curriculum.ts';

interface Props { variant?: 'full' | 'preview'; }
const { variant = 'full' } = Astro.props;

const groups = groupNames.map((label) => ({ label, items: tracks.filter((t) => t.group === label) }));
const dotClass = (s: NodeStatus) =>
  s === 'curated' ? 'node-dot is-curated' : s === 'coming' ? 'node-dot is-coming' : 'node-dot';
---
<div class:list={['tree', variant]}>
  {groups.map((g) => (
    <section class="grp">
      <div class="grp-head"><span class="eyebrow">{g.label}</span><span class="grp-rule"></span></div>
      <div class="grp-grid">
        {g.items.map((t) => (
          <article class="track">
            <a href={`/learn/${t.id}`} class="hub-row">
              <span class="hub mono">{t.n}</span>
              <span class="tname">{t.name}</span>
            </a>
            <div class="tmeta mono">{t.meta}</div>
            {variant === 'full' ? (
              <ul class="nodes">
                {t.nodes.map((nd) => (
                  <li class="node">
                    <span class={dotClass(nd.status)} aria-hidden="true"></span>
                    {nd.slug ? (
                      <a href={`/learn/${t.id}/${nd.slug}`} class="ntitle">{nd.title}</a>
                    ) : (
                      <span class:list={['ntitle', { dim: nd.status !== 'live' }]}>{nd.title}</span>
                    )}
                    {nd.eta && <span class="status-chip">{nd.eta}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <div class="dots">
                {t.nodes.map((nd) => (<span class={dotClass(nd.status)} aria-hidden="true"></span>))}
                <a href={`/learn/${t.id}`} class="more mono">Open →</a>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="lane">
    <div class="lane-head">
      <span class="eyebrow">Role tracks</span>
      <span class="lane-sub">Start here if you're not writing code. Each one ends in something you can show.</span>
    </div>
    <div class="roles">
      {roleTracks.map((r) => (
        <a href={`/roles/${r.id}`} class="role">
          <span class={dotClass(r.status)} aria-hidden="true"></span>
          <span class="rname">{r.name}</span>
          <span class="rblurb">{r.blurb}</span>
        </a>
      ))}
    </div>
  </section>
</div>

<style>
  .tree { display: flex; flex-direction: column; gap: 40px; }
  .grp-head { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .grp-rule { flex: 1; height: 1px; background: var(--rule); }
  .grp-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px 28px; }

  .hub-row { display: flex; align-items: center; gap: 10px; }
  .hub-row:hover { text-decoration: none; }
  .hub-row:hover .tname { color: var(--accent); }
  .hub { flex: none; width: 26px; height: 26px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--accent); color: var(--accent-contrast); font-size: 11px; font-weight: 500; }
  .tname { font: 600 17px/1.15 'Source Serif 4', Georgia, serif; letter-spacing: -.008em; color: var(--text); }
  .tmeta { font-size: 10.5px; color: var(--faint); letter-spacing: .02em; margin: 9px 0 12px 36px; }

  .nodes { list-style: none; padding: 0; margin: 0 0 0 12px; position: relative; display: flex; flex-direction: column; gap: 2px; }
  .nodes::before { content: ""; position: absolute; left: 5px; top: 7px; bottom: 9px; width: 1px; background: var(--spine); }
  .node { display: flex; align-items: flex-start; gap: 9px; padding: 5px 0; }
  .node .node-dot { margin-top: 3px; }
  .ntitle { font: 500 12.5px/1.35 'IBM Plex Sans', sans-serif; color: var(--text); }
  a.ntitle:hover { color: var(--accent); text-decoration: none; }
  .ntitle.dim { color: var(--muted); font-weight: 400; }
  .status-chip { margin-top: 1px; }

  .dots { display: flex; align-items: center; gap: 6px; margin: 6px 0 0 12px; }
  .dots .more { margin-left: 6px; font-size: 11px; color: var(--accent); }
  .dots .more:hover { text-decoration: none; opacity: .8; }

  .lane { border: 1px solid var(--rule); border-radius: 12px; background: var(--paper); padding: 20px 24px 24px; }
  .lane-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; flex-wrap: wrap; }
  .lane-sub { font-size: 12.5px; color: var(--muted); }
  .roles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 22px 20px; }
  .role { display: flex; flex-direction: column; gap: 8px; }
  .role:hover { text-decoration: none; }
  .role:hover .rname { color: var(--accent); }
  .rname { font: 600 14px/1.2 'IBM Plex Sans', sans-serif; color: var(--text); }
  .rblurb { font: 400 11.5px/1.45 'IBM Plex Sans', sans-serif; color: var(--muted); }

  @media (max-width: 1000px) { .grp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .roles { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .grp-grid { grid-template-columns: 1fr; } .roles { grid-template-columns: repeat(2, 1fr); } }
</style>
