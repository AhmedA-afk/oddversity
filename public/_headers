# Cloudflare Pages / Netlify convention. Vercel ignores this file — the
# active configuration for the current deploy target is vercel.json at the
# repo root. Keep the two in step if you ever move hosts.

# Response headers for Cloudflare Pages / Netlify.
# Static content site: no accounts, no cookies, no server-side state.

/*
  # Clickjacking, MIME sniffing and referrer leakage.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # Nothing here needs a camera, a microphone or a location.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # Two years, subdomains included. Only enable preload once the apex and
  # every subdomain are confirmed HTTPS-only.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # Everything is first-party. Fonts are self-hosted, there is no analytics
  # script, no external image host and no embedded frames.
  # 'unsafe-inline' for styles covers Astro's scoped <style> blocks; the
  # inline scripts are the theme bootstrap and the quiz island.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests

# Hashed build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/icons/*
  Cache-Control: public, max-age=604800

# Content changes; let a CDN serve stale briefly while it revalidates.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/rss.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
