---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { ogImage } from '../../data/og-images';

const topics = (await getCollection('questions'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    entry,
    // Count the questions rather than asserting a number that can drift.
    count: ('\n' + (entry.body ?? '')).split(/\n## /).length - 1,
  }));
const totalQuestions = topics.reduce((n, t) => n + t.count, 0);
---
<Layout
  title="AI interview questions"
  description={`${totalQuestions} practical AI engineering interview questions with worked answers — LLM basics, prompting, RAG, agents, MCP, evals and AI system design. Free, and every answer links to the lesson behind it.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Interview', url: '/interview' }]}
  itemList={topics.map((t) => ({ name: t.entry.data.title, url: `/interview/${t.entry.id}` }))}
  image={ogImage('page-interview')}
  imageAlt="Oddversity interview questions"
>
  <section class="interview-hero container">
    <span class="eyebrow">Interview desk</span>
    <h1>Questions worth preparing for.</h1>
    <p>{totalQuestions} answers to the concepts interviewers use to separate vocabulary from working judgment. Read a topic, follow the lesson links, then explain it in your own words — that last step is the one that matters.</p>
  </section>
  <section class="topic-grid container" aria-label="Interview topics">
    {topics.map(({ entry, count }) => (
      <a class="topic-card" href={`/interview/${entry.id}`}>
        <span class="topic-number mono">{String(entry.data.order).padStart(2, '0')}</span>
        <h2>{entry.data.topic}</h2>
        <p>{entry.data.description}</p>
        <span class="topic-link mono">{count} questions →</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .interview-hero { padding-block: 58px 44px; max-width: 760px; }
  .interview-hero h1 { font-size: clamp(34px, 5vw, 52px); margin-top: 14px; }
  .interview-hero p { max-width: 62ch; margin-top: 18px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  .topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .topic-card { background: var(--bg); padding: 28px; min-height: 216px; display: flex; flex-direction: column; }
  .topic-card:hover { background: var(--paper); text-decoration: none; }
  .topic-number { color: var(--faint); font-size: 11px; }
  .topic-card h2 { margin-top: 28px; font-size: 24px; }
  .topic-card p { margin-top: 10px; color: var(--muted); line-height: 1.55; }
  .topic-link { margin-top: auto; padding-top: 22px; color: var(--accent); font-size: 11px; }
  @media (max-width: 680px) { .topic-grid { grid-template-columns: 1fr; } }
</style>
