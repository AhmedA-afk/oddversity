---
import Figure from './Figure.astro';

/**
 * Chunk overlap, drawn on a shared page scale so the boundary hazard is
 * geometric rather than asserted.
 *
 * Every number here comes from the lesson's worked example and nothing else:
 * a 30-page contract, three windows of pages 1-12, 11-22 and 21-30 (a 2-page
 * overlap), and a Limitation of Liability clause running from the bottom of
 * page 21 to the top of page 23.
 *
 * Brass is the clause, and only the clause. It is the thing that breaks: it
 * sits whole inside chunk 3 and truncated inside chunk 2, so the merge step
 * receives two copies of one entity and has to decide which is real. The
 * chunk windows themselves are ordinary machinery, so they are indigo.
 *
 * Seven primary elements — the contract, three chunks, three drawings of the
 * clause — which is the grammar's ceiling. Nothing may be added here without
 * splitting the figure.
 */

/** Page scale. Page p occupies the interval [p-1, p]. */
const S = 17.5;
const X0 = 92; // left gutter carries the page range of each chunk
const px = (u: number) => X0 + u * S;

const DOC_Y = 44;
const DOC_H = 26;
const ROW_H = 30;
const ROWS = [104, 154, 204];

/** Clause extent: bottom of page 21 to top of page 23. */
const C_A = 20.6;
const C_B = 22.4;

const chunks = [
  { from: 0,  to: 12, label: 'CHUNK 1', pages: 'pages 1–12' },
  { from: 10, to: 22, label: 'CHUNK 2', pages: 'pages 11–22' },
  { from: 20, to: 30, label: 'CHUNK 3', pages: 'pages 21–30' },
];
---
<Figure
  title="Chunk overlap and the clause that straddles a boundary"
  caption="Overlap guarantees the Limitation of Liability clause lands whole in chunk 3, but it still appears cut off at page 22 in chunk 2, so the merge step receives two copies of one clause and has to know which is complete."
  desc="A 30-page contract is drawn as a bar. Beneath it, three chunk windows are staggered on the same page scale: pages 1 to 12, pages 11 to 22, and pages 21 to 30, giving a two-page overlap between neighbours. A clause running from page 21 to page 23 is marked on the contract and appears twice below: truncated at the page 22 edge of chunk 2, and complete inside chunk 3."
>
  <svg viewBox="0 0 640 264" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    {/* The document, and the one clause worth watching inside it. */}
    <rect x={px(0)} y={DOC_Y} width={px(30) - px(0)} height={DOC_H} rx="6" class="dg-box-mute" />
    <text x={(px(0) + px(30)) / 2} y={DOC_Y + DOC_H / 2 + 4} class="dg-label">30-PAGE CONTRACT</text>

    <rect x={px(C_A)} y={DOC_Y} width={px(C_B) - px(C_A)} height={DOC_H} rx="6" class="dg-box-warn" />
    <text x={(px(C_A) + px(C_B)) / 2} y={DOC_Y - 12} class="dg-note dg-note-warn">
      Limitation of Liability, pages 21–23
    </text>

    {/* The edge that does the damage: where chunk 2 stops. */}
    <line x1={px(22)} y1={DOC_Y + DOC_H} x2={px(22)} y2={ROWS[1] - 2} class="dg-line-warn" />

    {/* The three windows, staggered on the same scale so the overlap is visible. */}
    {chunks.map((c, i) => (
      <>
        <rect x={px(c.from)} y={ROWS[i]} width={px(c.to) - px(c.from)} height={ROW_H} rx="6" class="dg-box" />
        <text x={(px(c.from) + px(c.to)) / 2} y={ROWS[i] + ROW_H / 2 + 4} class="dg-label">{c.label}</text>
        <text x={X0 / 2} y={ROWS[i] + ROW_H / 2 + 4} class="dg-note">{c.pages}</text>
      </>
    ))}

    <text x={(px(10) + px(12)) / 2} y={ROWS[0] + ROW_H + 14} class="dg-note">2-page overlap</text>

    {/* The same clause, twice: cut in one window, whole in the next. */}
    <rect x={px(C_A)} y={ROWS[1]} width={px(22) - px(C_A)} height={ROW_H} rx="6" class="dg-box-warn" />
    <text x={(px(C_A) + px(C_B)) / 2} y={ROWS[1] + ROW_H + 14} class="dg-note dg-note-warn">
      cut off at page 22
    </text>

    <rect x={px(C_A)} y={ROWS[2]} width={px(C_B) - px(C_A)} height={ROW_H} rx="6" class="dg-box-warn" />
    <text x={(px(C_A) + px(C_B)) / 2} y={ROWS[2] + ROW_H + 14} class="dg-note dg-note-warn">
      extracted whole
    </text>
  </svg>
</Figure>
