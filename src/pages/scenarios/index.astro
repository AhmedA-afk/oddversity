---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const scenarios = (await getCollection('scenarios')).sort((a, b) => a.data.order - b.data.order);
---
<Layout
  title="AI system design scenarios"
  description="Realistic AI-building scenarios worked through end to end — architecture, permissions, evaluation and the trade-off you actually have to make. Useful as interview practice or a pre-build check."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Scenarios', url: '/scenarios' }]}
  itemList={scenarios.map((s) => ({ name: s.data.title, url: `/scenarios/${s.id}` }))}
>
  <section class="scenario-hero container">
    <span class="eyebrow">Field notes</span>
    <h1>Practice the decision, not just the definition.</h1>
    <p>Each scenario starts with a plausible product constraint, then works through the smallest dependable design. Use them as interview prompts or as a pre-build check.</p>
  </section>
  <section class="scenario-list container" aria-label="Scenarios">
    {scenarios.map((entry) => (
      <a href={`/scenarios/${entry.id}`} class="scenario-card">
        <span class="mono scenario-num">{String(entry.data.order).padStart(2, '0')}</span>
        <div><span class="eyebrow">{entry.data.scenario}</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div>
        <span class="mono arrow">Read the walkthrough →</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .scenario-hero { padding-block: 58px 44px; max-width: 800px; }
  .scenario-hero h1 { font-size: clamp(34px, 5vw, 52px); margin-top: 14px; max-width: 16ch; }
  .scenario-hero p { margin-top: 18px; color: var(--muted); font-size: 16px; line-height: 1.7; max-width: 62ch; }
  .scenario-list { border-top: 1px solid var(--rule); }
  .scenario-card { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 24px; align-items: center; padding: 26px 4px; border-bottom: 1px solid var(--rule); }
  .scenario-card:hover { text-decoration: none; background: var(--paper); padding-inline: 16px; margin-inline: -16px; }
  .scenario-num, .arrow { color: var(--faint); font-size: 11px; }
  .scenario-card h2 { margin-top: 8px; font-size: 24px; }
  .scenario-card p { margin-top: 7px; color: var(--muted); }
  .arrow { color: var(--accent); white-space: nowrap; }
  @media (max-width: 680px) { .scenario-card { grid-template-columns: 36px minmax(0, 1fr); gap: 14px; } .arrow { grid-column: 2; } }
</style>
