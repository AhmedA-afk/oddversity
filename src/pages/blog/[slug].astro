---
import Layout from '../../components/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { ogImage } from '../../data/og-images';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);

const all = (await getCollection('blog')).sort(
  (a, b) => Date.parse(b.data.published) - Date.parse(a.data.published),
);
const more = all.filter((p) => p.id !== entry.id).slice(0, 3);
const guides = (await getCollection('guides')).slice(0, 2);
---
<Layout title={entry.data.title} description={entry.data.description} type="article" image={ogImage(`blog-${entry.id}`)} imageAlt={entry.data.title} publishedTime={entry.data.published} modifiedTime={entry.data.updated} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: entry.data.title, url: `/blog/${entry.id}` }]}>
  <div class="blog-layout container">
    <article class="blog-doc">
      <a class="back mono" href="/blog">← All notes</a>
      <time class="mono date" datetime={entry.data.published}>{entry.data.published}</time>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <div class="prose"><Content /></div>

      <div class="tagrow chips">{entry.data.tags.map((t) => <span class="chip">{t}</span>)}</div>

      {more.length > 0 && (
        <section class="more">
          <div class="eyebrow">Read next</div>
          <ul>
            {more.map((p) => (
              <li><a href={`/blog/${p.id}`}>{p.data.title}</a><span>{p.data.description}</span></li>
            ))}
          </ul>
        </section>
      )}

      {guides.length > 0 && (
        <section class="more">
          <div class="eyebrow">Or go and build something</div>
          <ul>
            {guides.map((g) => (
              <li><a href={`/guides/${g.id}`}>{g.data.title}</a><span>{g.data.description}</span></li>
            ))}
          </ul>
        </section>
      )}

      <AdSlot />
    </article>
    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && <><div class="eyebrow">On this page</div><ul>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></>}
    </aside>
  </div>
</Layout>

<style is:global>
  .blog-layout { display: grid; grid-template-columns: minmax(0, 720px) 220px; gap: 72px; padding-top: 48px; align-items: start; }
  .blog-doc { min-width: 0; }
  .blog-doc .back { display: block; margin-bottom: 34px; color: var(--muted); font-size: 11px; }
  .blog-doc .back:hover { color: var(--accent); text-decoration: none; }
  .blog-doc .date { display: block; color: var(--muted); font-size: 11px; }
  .blog-doc .tagrow { margin-top: 34px; }
  .blog-doc .more { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--rule); }
  .blog-doc .more ul { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-direction: column; gap: 12px; }
  .blog-doc .more li { display: flex; flex-direction: column; gap: 3px; }
  .blog-doc .more a { font: 500 14.5px/1.35 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .blog-doc .more span { font-size: 12.5px; line-height: 1.5; color: var(--muted); }
  .blog-doc h1 { margin-top: 13px; font-size: clamp(36px, 5vw, 52px); max-width: 17ch; }
  .blog-doc .lede { margin-top: 16px; color: var(--muted); font-size: 17px; line-height: 1.65; }
  .blog-doc .prose { margin-top: 42px; font-size: 16px; line-height: 1.75; }
  .blog-doc .prose h2 { font-size: 25px; margin-top: 1.9em; scroll-margin-top: 88px; }
  .blog-doc .prose p { margin-top: 1em; }
  .blog-doc .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .toc { position: sticky; top: 92px; border-left: 1px solid var(--rule); padding-left: 18px; }
  .toc ul { list-style: none; padding: 0; margin-top: 14px; display: flex; flex-direction: column; gap: 9px; }
  .toc a { color: var(--muted); font-size: 12px; line-height: 1.4; }
  .toc a:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 860px) { .blog-layout { grid-template-columns: 1fr; gap: 28px; } .toc { display: none; } }
</style>
