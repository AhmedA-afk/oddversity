---
import Wordmark from './Wordmark.astro';

const nav = [
  { label: 'Learn', href: '/learn' },
  { label: 'Guides', href: '/guides' },
  { label: 'Practice', href: '/practice' },
  { label: 'Interview', href: '/interview' },
  { label: 'Reference', href: '/reference' },
  { label: 'Blog', href: '/blog' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="bar">
  <div class="inner">
    <Wordmark size={21} />

    <nav class="nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['nlink', { active: isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="right">
      <button type="button" class="search" data-search-open aria-label="Search the site">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="5.4"></circle><path d="M13.2 13.2L17 17"></path></svg>
        <span class="ph">Search the site</span>
        <span class="kbd mono" aria-hidden="true">⌘K</span>
      </button>

      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle dark mode">
        <svg class="sun" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.6"></circle><path d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M15.8 4.2l-1.4 1.4M5.6 14.4l-1.4 1.4M15.8 15.8l-1.4-1.4M5.6 5.6L4.2 4.2"></path></svg>
        <svg class="moon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 11.2A6.8 6.8 0 1 1 8.8 3.5a5.4 5.4 0 0 0 7.7 7.7Z"></path></svg>
      </button>

      <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"></path></svg>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {nav.map((n) => (<a href={n.href} class:list={['mlink', { active: isActive(n.href) }]}>{n.label}</a>))}
      <a href="/roles" class="mlink">Role paths</a>
      <a href="/scenarios" class="mlink">Scenarios</a>
      <a href="/about" class="mlink">About</a>
    </nav>
  </div>
</header>

<div class="sdlg" data-search-dialog hidden>
  <div class="sbackdrop" data-search-close></div>
  <div class="spanel" role="dialog" aria-modal="true" aria-label="Search Oddversity">
    <div class="sinput-row">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="5.4"></circle><path d="M13.2 13.2L17 17"></path></svg>
      <input type="search" data-search-input placeholder="Search lessons, guides, quizzes…" aria-label="Search query" autocomplete="off" spellcheck="false" />
      <kbd class="mono">esc</kbd>
    </div>
    <div class="sresults" data-search-results role="listbox" aria-label="Search results"></div>
    <div class="sfoot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span><span><kbd>↵</kbd> open</span><span data-search-count></span>
    </div>
  </div>
</div>

<style>
  .bar { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--rule); }
  .inner { max-width: 1280px; margin-inline: auto; height: 64px; display: flex; align-items: center; gap: 26px; padding: 0 32px; }
  .nav { display: flex; align-items: center; gap: 19px; flex: none; }
  .nlink { font: 400 13.5px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--muted); padding-block: 6px; border-bottom: 2px solid transparent; }
  .nlink:hover { color: var(--text); text-decoration: none; }
  .nlink.active { color: var(--text); font-weight: 500; border-bottom-color: var(--accent); }
  .right { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 10px; }

  .search { display: flex; align-items: center; gap: 8px; width: 236px; height: 34px; padding: 0 8px 0 11px; border: 1px solid var(--rule); border-radius: 6px; background: var(--paper-2); color: var(--muted); cursor: pointer; font: inherit; text-align: left; }
  .search:hover { border-color: var(--spine-arrow); color: var(--text); }
  .search .ph { flex: 1; font: 400 12.5px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .kbd { font-size: 10.5px; color: var(--muted); background: var(--chip-bg); border: 1px solid var(--rule); border-radius: 4px; padding: 3px 5px; }

  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--rule); border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  .icon-btn:hover { color: var(--text); background: var(--paper); }
  .icon-btn .moon { display: none; }
  :root[data-theme="dark"] .icon-btn .sun { display: none; }
  :root[data-theme="dark"] .icon-btn .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-btn .sun { display: none; }
    :root:not([data-theme="light"]) .icon-btn .moon { display: block; }
  }
  .menu-btn { display: none; }

  .mobile { border-top: 1px solid var(--rule); background: var(--bg); padding: 8px 20px 16px; }
  .mobile nav { display: flex; flex-direction: column; }
  .mlink { padding: 11px 4px; font: 500 15px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--muted); border-bottom: 1px solid var(--rule); }
  .mlink:last-child { border-bottom: 0; }
  .mlink.active { color: var(--accent); }

  @media (max-width: 1080px) { .nav { gap: 14px; } .search { width: 150px; } .search .ph { display: none; } }
  @media (max-width: 900px) {
    .inner { padding: 0 20px; gap: 12px; }
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .search { width: 34px; padding: 0; justify-content: center; }
    .search .ph, .search .kbd { display: none; }
  }
  @media (min-width: 901px) { .mobile { display: none !important; } }

  /* Search dialog */
  .sdlg { position: fixed; inset: 0; z-index: 120; display: flex; justify-content: center; align-items: flex-start; padding: 10vh 16px 16px; }
  .sdlg[hidden] { display: none; }
  .sbackdrop { position: absolute; inset: 0; background: rgba(20,19,17,.42); backdrop-filter: blur(2px); }
  .spanel { position: relative; width: min(680px, 100%); max-height: 74vh; display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--rule); border-radius: 12px; box-shadow: 0 18px 48px rgba(20,19,17,.18); overflow: hidden; }
  .sinput-row { display: flex; align-items: center; gap: 10px; padding: 0 16px; height: 54px; border-bottom: 1px solid var(--rule); color: var(--muted); flex: none; }
  .sinput-row input { flex: 1; border: 0; background: none; outline: none; font: 400 16px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--text); }
  .sinput-row input::-webkit-search-cancel-button { display: none; }
  .sinput-row kbd { font-size: 10.5px; color: var(--muted); background: var(--chip-bg); border: 1px solid var(--rule); border-radius: 4px; padding: 3px 6px; font-family: 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; }
  .sresults { overflow-y: auto; padding: 6px; flex: 1; min-height: 0; }
  .sfoot { flex: none; display: flex; gap: 16px; align-items: center; padding: 9px 16px; border-top: 1px solid var(--rule); font-size: 11px; color: var(--muted); background: var(--paper); }
  .sfoot kbd { background: var(--chip-bg); border: 1px solid var(--rule); border-radius: 3px; padding: 1px 4px; margin-right: 3px; font-family: 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; }
  .sfoot span:last-child { margin-left: auto; }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (btn) btn.addEventListener('click', function () {
      var root = document.documentElement;
      var cur = root.getAttribute('data-theme');
      if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('fg-theme', next); } catch (e) {}
    });
    var mt = document.querySelector('[data-menu-toggle]');
    var mm = document.getElementById('mobile-menu');
    if (mt && mm) mt.addEventListener('click', function () {
      var open = mm.hidden;
      mm.hidden = !open;
      mt.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
