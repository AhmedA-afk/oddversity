---
/**
 * Wrapper for every diagram on the site.
 *
 * Enforces the two things docs/visual-system.md requires of all of them: a
 * caption stating what the figure shows, and an accessible name. The diagram is
 * always a second way in, never the only way in — the prose around it must
 * carry the same information.
 */
interface Props {
  /** Accessible name. Becomes the SVG's <title>. */
  title: string;
  /** The one sentence printed beneath the figure. */
  caption: string;
  /** Longer description for a diagram whose structure is not self-evident. */
  desc?: string;
}
const { title, caption, desc } = Astro.props;
---
<figure class="fig">
  <div class="fig-canvas" role="img" aria-label={title}>
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
  {desc && <p class="sr-only">{desc}</p>}
</figure>

<style>
  .fig { margin: 2em 0; }
  .fig-canvas { width: 100%; }
  .fig-canvas :global(svg) { width: 100%; height: auto; display: block; }

  figcaption {
    margin-top: 12px;
    padding-left: 14px;
    border-left: 2px solid var(--rule);
    font: 400 13px/1.6 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif;
    color: var(--muted);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>

<style is:global>
  /* Diagram primitives. Every figure draws from these so the whole site speaks
     one visual language, and every colour is a token so light and dark both
     work without a second asset.

     The identity: indigo is what happens, brass is what breaks. */
  .dg-box      { fill: var(--paper); stroke: var(--brand-cool); stroke-width: 1.5; }
  .dg-box-warn { fill: var(--paper); stroke: var(--brand-warm); stroke-width: 1.5; }
  .dg-box-mute { fill: var(--paper); stroke: var(--rule);       stroke-width: 1.5; }

  .dg-line      { stroke: var(--brand-cool); stroke-width: 1.5; fill: none; }
  .dg-line-warn { stroke: var(--brand-warm); stroke-width: 1.5; fill: none; stroke-dasharray: 1.5 4; }
  .dg-rule      { stroke: var(--rule); stroke-width: 1.5; fill: none; }

  /* Component names: mono, uppercase, tracked. One to three words, never a
     sentence inside a shape. */
  .dg-label {
    fill: var(--text);
    font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace;
    letter-spacing: .08em;
    text-anchor: middle;
  }
  .dg-label-warn { fill: var(--brand-warm); }

  /* Annotations sit outside shapes, sentence case. */
  .dg-note {
    fill: var(--muted);
    font: 400 11.5px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif;
    text-anchor: middle;
  }
  .dg-note-warn { fill: var(--brand-warm); }

  .dg-arrow      { fill: var(--brand-cool); }
  .dg-arrow-warn { fill: var(--brand-warm); }
</style>
