---
import Layout from '../../components/Layout.astro';
import { terms, glossaryGroups, slugForTerm } from '../../data/glossary';
import { ogImage } from '../../data/og-images';

const grouped = glossaryGroups.map((g) => ({ name: g, items: terms.filter((t) => t.group === g) }));
const faq = terms.map((t) => ({ q: `What is ${t.term}?`, a: `${t.short} ${t.body}` }));
---
<Layout
  title="Glossary of AI engineering terms"
  description={`${terms.length} terms an AI engineer actually uses — tokens, context windows, RAG, chunking, agents, MCP, evals, LoRA and the rest — defined plainly, with the misuse each definition is trying to prevent.`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Reference', url: '/reference' },
    { name: 'Glossary', url: '/reference/glossary' },
  ]}
  faq={faq}
  image={ogImage('page-glossary')}
  imageAlt="Oddversity glossary of AI engineering terms"
>
  <section class="head container">
    <span class="eyebrow">Reference</span>
    <h1>Glossary</h1>
    <p class="sub">
      {terms.length} terms, defined plainly. Each one has a one-line answer and then the part
      that stops it being misused — because most of these words are misused in a specific,
      predictable way, and that is usually what you needed to know.
    </p>
    <input type="search" data-catalog-filter class="filter" placeholder="Filter terms — try “context”, “tuning”, “injection”" aria-label="Filter glossary terms" />
    <nav class="jump" aria-label="Jump to group">
      {grouped.map((g) => <a href={`#${slugForTerm(g.name)}`}>{g.name}</a>)}
    </nav>
  </section>

  <div class="container body">
    {grouped.map((g) => (
      <section class="grp" id={slugForTerm(g.name)} data-catalog-group>
        <h2>{g.name}</h2>
        <dl>
          {g.items.map((t) => (
            <div class="entry" id={slugForTerm(t.term)} data-catalog-card data-search={`${t.term} ${t.short} ${t.body}`}>
              <dt>
                {t.term}
                <a class="anchor mono" href={`#${slugForTerm(t.term)}`} aria-label={`Link to ${t.term}`}>#</a>
              </dt>
              <dd>
                <p class="short">{t.short}</p>
                <p class="long">{t.body}</p>
                {t.see && <a class="see mono" href={t.see}>Full lesson →</a>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
    <p class="empty" data-catalog-empty hidden>No term matches that.</p>
  </div>
</Layout>

<style>
  .head { padding-block: 56px 8px; }
  .head h1 { font-size: clamp(32px, 5vw, 46px); letter-spacing: -.022em; margin-top: 12px; }
  .sub { margin-top: 18px; color: var(--muted); max-width: 64ch; font-size: 15.5px; line-height: 1.7; }
  .filter { margin-top: 24px; width: min(420px, 100%); height: 40px; padding: 0 14px; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper-2); color: var(--text); font: 400 13.5px/1 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .filter::placeholder { color: var(--muted); }
  .jump { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a { font: 400 11.5px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: var(--muted); background: var(--chip-bg); border: 1px solid var(--rule); border-radius: 4px; padding: 6px 9px; }
  .jump a:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }

  .body { padding-top: 20px; }
  .grp { padding-top: 44px; scroll-margin-top: 84px; }
  .grp h2 { font-size: 20px; letter-spacing: -.014em; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  dl { margin: 0; }
  .entry { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 28px; padding-block: 22px; border-bottom: 1px solid var(--rule); scroll-margin-top: 84px; }
  dt { font: 600 17px/1.3 'Source Serif 4', 'Source Serif 4 Fallback', Georgia, serif; color: var(--text); display: flex; align-items: baseline; gap: 7px; }
  .anchor { font-size: 12px; color: var(--rule); }
  .entry:hover .anchor { color: var(--muted); }
  .anchor:hover { color: var(--accent); text-decoration: none; }
  dd { margin: 0; }
  .short { font-size: 14.5px; line-height: 1.6; color: var(--text); font-weight: 500; }
  .long { margin-top: 9px; font-size: 14px; line-height: 1.68; color: var(--muted); }
  .see { display: inline-block; margin-top: 11px; font-size: 11.5px; color: var(--accent); }
  .empty { padding-block: 40px; color: var(--muted); }
  @media (max-width: 760px) {
    .entry { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
