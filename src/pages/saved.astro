---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import { tracks } from '../data/curriculum.ts';
import { fdePhases, fdeRole } from '../data/fde';

// Per-track totals so the page can draw meters from the reader's own
// localStorage. Keyed by the same prefixes the lesson ids use.
const lessons = await getCollection('lessons');
const meta: Record<string, { name: string; url: string; total: number }> = {};
for (const t of tracks) {
  const total = lessons.filter((l) => l.id.startsWith(`${t.id}/`)).length;
  if (total) meta[t.id] = { name: t.name, url: `/learn/${t.id}`, total };
}
for (const p of fdePhases) {
  meta[`fde/${p.id}`] = { name: `${fdeRole.short} · ${p.name}`, url: `/roles/${fdeRole.id}/${p.id}`, total: p.modules.reduce((n, m) => n + m.nodes.length, 0) };
}
---
<Layout
  title="Saved"
  description="Where you left off, the lessons you saved for later, what you opened recently, and your progress per track. Stored only in this browser; export it to carry it elsewhere."
  noindex={true}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Saved', url: '/saved' }]}
>
  <div class="container saved-page" data-saved-page>
    <section class="head">
      <span class="eyebrow">Your place</span>
      <h1>Pick up where you left off</h1>
      <p class="sub">Everything on this page lives in this browser's storage and nowhere else. No account, nothing sent anywhere. Use export to carry it to another browser or device.</p>
    </section>

    <section class="block">
      <h2>Continue</h2>
      <div class="cont" data-saved-continue></div>
    </section>

    <section class="block">
      <h2>Saved for later</h2>
      <div data-saved-bookmarks></div>
    </section>

    <section class="block">
      <h2>Recently opened</h2>
      <div data-saved-recent></div>
    </section>

    <section class="block">
      <h2>Progress by track</h2>
      <div data-saved-progress></div>
    </section>

    <section class="block">
      <h2>Move your place to another browser</h2>
      <p class="hint">Copy the text below, then paste it into the import box on the other browser's Saved page. It contains only lesson identifiers and timestamps.</p>
      <div class="io">
        <label class="io-col">
          <span class="mono lbl">Export</span>
          <textarea data-saved-export readonly rows="4" spellcheck="false" aria-label="Exported saved data"></textarea>
          <button type="button" class="btn btn-ghost" data-saved-copy>Copy</button>
        </label>
        <label class="io-col">
          <span class="mono lbl">Import</span>
          <textarea data-saved-import-box rows="4" spellcheck="false" placeholder="Paste exported text here" aria-label="Paste saved data to import"></textarea>
          <button type="button" class="btn btn-ghost" data-saved-import>Import and merge</button>
          <span class="msg mono" data-saved-import-msg aria-live="polite"></span>
        </label>
      </div>
    </section>

    <section class="block danger">
      <button type="button" class="btn btn-ghost" data-saved-clear>Clear all saved data</button>
      <span class="hint">Removes progress, bookmarks and history from this browser. Cannot be undone.</span>
    </section>
  </div>

  <script type="application/json" data-saved-tracks set:html={JSON.stringify(meta)}></script>
</Layout>

<style>
  .saved-page { padding-block: 48px 80px; max-width: 820px; }
  .head h1 { font-size: clamp(30px, 4.5vw, 40px); letter-spacing: -.02em; margin-top: 12px; }
  .sub { margin-top: 14px; color: var(--muted); font-size: 15px; line-height: 1.6; max-width: 62ch; }
  .block { margin-top: 40px; }
  .block h2 { font-size: 20px; letter-spacing: -.01em; margin-bottom: 12px; }
  .cont { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .hint { font-size: 13px; color: var(--muted); line-height: 1.55; }
  .io { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 14px; }
  .io-col { display: flex; flex-direction: column; gap: 8px; }
  .lbl { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper); color: var(--text); font: 12px/1.5 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; resize: vertical; }
  .msg { font-size: 11.5px; color: var(--accent); min-height: 1em; }
  .danger { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid var(--rule); }
  @media (max-width: 640px) { .io { grid-template-columns: 1fr; } }
</style>
