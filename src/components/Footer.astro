---
const cols = [
  { head: 'Learn', links: [['Skill tree', '/learn'], ['Role tracks', '/roles'], ['Reference', '/reference']] },
  { head: 'Explore', links: [['Benchmarks', '/benchmarks'], ['Stats', '/stats'], ['Blog', '/blog']] },
  { head: 'Project', links: [['About', '/about'], ['GitHub', '#'], ['Newsletter', '#']] },
];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="inner">
    <div class="brand">
      <a href="/" class="logo"><span class="tick" aria-hidden="true"></span><span class="word">Fieldguide</span></a>
      <p class="tag">Learn to actually build with AI.<br /><strong>Free. Always.</strong></p>
    </div>
    <div class="cols">
      {cols.map((c) => (
        <div class="col">
          <div class="eyebrow">{c.head}</div>
          <ul>
            {c.links.map(([label, href]) => (<li><a href={href}>{label}</a></li>))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="base">
    <span>© {year} Fieldguide</span>
    <span class="mono">A free, hands-on guide to building with AI.</span>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--rule); background: var(--paper); margin-top: 72px; }
  .inner { max-width: 1280px; margin-inline: auto; padding: 44px 32px 32px; display: flex; flex-wrap: wrap; gap: 48px; justify-content: space-between; }
  .logo { display: flex; align-items: center; gap: 8px; }
  .logo:hover { text-decoration: none; }
  .tick { width: 5px; height: 19px; background: var(--accent); border-radius: 1px; }
  .word { font: 600 20px/1 'Source Serif 4', Georgia, serif; letter-spacing: -.012em; color: var(--text); }
  .tag { margin-top: 12px; color: var(--muted); font-size: 13.5px; line-height: 1.5; }
  .tag strong { color: var(--text); font-weight: 600; }
  .cols { display: flex; gap: 56px; flex-wrap: wrap; }
  .col ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .col a { color: var(--muted); font-size: 13.5px; }
  .col a:hover { color: var(--text); text-decoration: none; }
  .base { max-width: 1280px; margin-inline: auto; padding: 16px 32px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .base span { font-size: 11.5px; color: var(--faint); }
  @media (max-width: 640px) { .cols { gap: 32px; } }
</style>
