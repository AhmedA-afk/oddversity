---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.published.localeCompare(a.data.published));
---
<Layout
  title="Blog"
  description="Practical notes on learning and building with AI — mental models, reliability, agents, retrieval and the operational detail that decides whether a feature survives real users."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }]}
  itemList={posts.map((p) => ({ name: p.data.title, url: `/blog/${p.id}` }))}
>
  <section class="blog-hero container">
    <span class="eyebrow">Field notes</span>
    <h1>Notes from the build.</h1>
    <p>Practical writing about learning AI, designing reliable systems, and keeping the interesting parts visible.</p>
    <a class="feed mono" href="/rss.xml">Subscribe by RSS →</a>
  </section>
  <section class="post-list container" aria-label="Blog posts">
    {posts.map((post, index) => (
      <a href={`/blog/${post.id}`} class="post-card">
        <span class="mono post-num">{String(index + 1).padStart(2, '0')}</span>
        <div><time class="mono" datetime={post.data.published}>{post.data.published}</time><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="tags">{post.data.tags.join(' · ')}</span></div>
        <span class="mono read">Read →</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .blog-hero { padding-block: 58px 44px; max-width: 780px; }
  .blog-hero h1 { font-size: clamp(36px, 5vw, 54px); margin-top: 14px; }
  .blog-hero p { margin-top: 17px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  .feed { display: inline-block; margin-top: 18px; font-size: 12px; color: var(--accent); }
  .post-list { border-top: 1px solid var(--rule); }
  .post-card { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 22px; align-items: start; padding: 28px 4px; border-bottom: 1px solid var(--rule); }
  .post-card:hover { background: var(--paper); text-decoration: none; padding-inline: 16px; margin-inline: -16px; }
  .post-num, .read, .post-card time { color: var(--muted); font-size: 11px; }
  .post-card h2 { margin-top: 10px; font-size: 25px; }
  .post-card p { margin-top: 8px; color: var(--muted); line-height: 1.55; max-width: 66ch; }
  .tags { display: block; margin-top: 13px; color: var(--muted); font: 400 11px/1.3 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; }
  .read { color: var(--accent); white-space: nowrap; }
  @media (max-width: 620px) { .post-card { grid-template-columns: 34px minmax(0, 1fr); gap: 14px; } .read { grid-column: 2; } }
</style>
