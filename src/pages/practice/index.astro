---
import Layout from '../../components/Layout.astro';
import { quizTracks } from '../../data/quizzes';
import { ogImage } from '../../data/og-images';
---
<Layout
  title="AI practice quizzes"
  description="Free multiple-choice quizzes on AI foundations, prompting, RAG, agents, MCP and evals — every answer explained, including why the wrong ones are wrong. No account, no timer."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Practice', url: '/practice' }]}
  itemList={quizTracks.map((t) => ({ name: `${t.name} quiz`, url: `/practice/${t.id}` }))}
  image={ogImage('page-practice')}
  imageAlt="Oddversity practice quizzes"
>
  <section class="practice-hero container">
    <span class="eyebrow">Practice room</span>
    <h1>Turn recognition into recall.</h1>
    <p>Pick a track, choose an answer, and read the explanation immediately. No account, no timer, and no pretending a score is the same thing as skill.</p>
  </section>
  <section class="practice-grid container" aria-label="Practice tracks">
    {quizTracks.map((track, index) => (
      <a class="practice-card" href={`/practice/${track.id}`}>
        <span class="mono index">{String(index + 1).padStart(2, '0')}</span>
        <h2>{track.name}</h2>
        <p>{track.summary}</p>
        <span class="mono start">{track.questions.length} questions →</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .practice-hero { padding-block: 58px 44px; max-width: 760px; }
  .practice-hero h1 { font-size: clamp(34px, 5vw, 52px); margin-top: 14px; }
  .practice-hero p { margin-top: 18px; color: var(--muted); font-size: 16px; line-height: 1.7; max-width: 62ch; }
  .practice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .practice-card { min-height: 216px; padding: 26px; background: var(--bg); display: flex; flex-direction: column; }
  .practice-card:hover { background: var(--paper); text-decoration: none; }
  .index { color: var(--faint); font-size: 11px; }
  .practice-card h2 { margin-top: 28px; font-size: 23px; }
  .practice-card p { margin-top: 10px; color: var(--muted); line-height: 1.55; }
  .start { margin-top: auto; padding-top: 22px; color: var(--accent); font-size: 11px; }
  @media (max-width: 820px) { .practice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .practice-grid { grid-template-columns: 1fr; } }
</style>
