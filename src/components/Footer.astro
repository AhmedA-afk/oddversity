---
import Wordmark from './Wordmark.astro';

const cols = [
  {
    head: 'Learn',
    links: [
      ['All tracks', '/learn'],
      ['Role paths', '/roles'],
      ['Guides', '/guides'],
      ['Reference & cheatsheets', '/reference'],
      ['Glossary', '/reference/glossary'],
    ],
  },
  {
    head: 'Practice',
    links: [
      ['Quizzes', '/practice'],
      ['Interview questions', '/interview'],
      ['Scenarios', '/scenarios'],
    ],
  },
  {
    head: 'Project',
    links: [
      ['Blog', '/blog'],
      ['About Oddversity', '/about'],
      ['RSS feed', '/rss.xml'],
    ],
  },
  {
    head: 'Legal',
    links: [
      ['Privacy', '/privacy'],
      ['Terms of use', '/terms'],
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="inner">
    <div class="brand">
      <Wordmark size={20} />
      <p class="tag">Learn to actually build with AI.<br /><strong>Free. Always.</strong></p>
      <button type="button" class="btn btn-ghost sbtn" data-search-open>Search the site ⌘K</button>
    </div>
    <div class="cols">
      {cols.map((c) => (
        <div class="col">
          <div class="eyebrow">{c.head}</div>
          <ul>
            {c.links.map(([label, href]) => (<li><a href={href}>{label}</a></li>))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="base">
    <span>© {year} Oddversity</span>
    <span class="mono note">No cookies · no tracking · no account required</span>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--rule); background: var(--paper); margin-top: 80px; }
  .inner { max-width: 1280px; margin-inline: auto; padding: 44px 32px 32px; display: flex; flex-wrap: wrap; gap: 48px; justify-content: space-between; }
  .tag { margin-top: 12px; color: var(--muted); font-size: 13.5px; line-height: 1.5; }
  .tag strong { color: var(--text); font-weight: 600; }
  .sbtn { margin-top: 18px; height: 34px; font-size: 12.5px; }
  .cols { display: flex; gap: 56px; flex-wrap: wrap; }
  .col ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .col a { color: var(--muted); font-size: 13.5px; }
  .col a:hover { color: var(--text); text-decoration: none; }
  .base { max-width: 1280px; margin-inline: auto; padding: 16px 32px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .base span { font-size: 12px; color: var(--muted); }
  .base .note { font-size: 11px; }
  @media (max-width: 640px) { .inner { padding: 32px 20px 24px; gap: 30px; } .cols { gap: 32px; } .base { padding: 14px 20px; } }
</style>
