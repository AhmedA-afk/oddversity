---
import Layout from '../../../components/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getTrack, type NodeStatus } from '../../../data/curriculum.ts';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => {
    const [track, ...rest] = entry.id.split('/');
    return { params: { track, lesson: rest.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { track: trackId, lesson: slug } = Astro.params;
const track = getTrack(trackId!);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const pageNodes = track ? track.nodes.filter((n) => n.slug) : [];
const curIndex = pageNodes.findIndex((n) => n.slug === slug);
const prev = pageNodes[curIndex - 1];
const next = pageNodes[curIndex + 1];

const dotClass = (s: NodeStatus) =>
  s === 'curated' ? 'node-dot is-curated' : s === 'coming' ? 'node-dot is-coming' : 'node-dot';
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <div class="wrap">
    <aside class="side" aria-label="Track contents">
      {track && (
        <div class="side-inner">
          <a href={`/learn/${track.id}`} class="side-track">{track.name}</a>
          <ul class="side-list">
            {track.nodes.map((nd) => (
              <li>
                {nd.slug ? (
                  <a href={`/learn/${track.id}/${nd.slug}`} class:list={['sl', { current: nd.slug === slug }]}>
                    <span class={dotClass(nd.status)} aria-hidden="true"></span><span>{nd.title}</span>
                  </a>
                ) : (
                  <span class="sl dim"><span class={dotClass(nd.status)} aria-hidden="true"></span><span>{nd.title}</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>

    <article class="doc">
      <nav class="crumb mono" aria-label="Breadcrumb">
        <a href="/learn">Learn</a> <span>/</span> <a href={`/learn/${track?.id}`}>{track?.name}</a>
      </nav>
      <h1>{entry.data.title}</h1>
      {entry.data.duration && <p class="dur mono">{entry.data.duration}</p>}
      {entry.data.summary && <p class="lede">{entry.data.summary}</p>}
      <div class="prose">
        <Content />
      </div>
      <nav class="pager" aria-label="Lesson navigation">
        {prev?.slug ? (
          <a href={`/learn/${track!.id}/${prev.slug}`} class="pg"><span class="mono">← Previous</span><span class="pt">{prev.title}</span></a>
        ) : <span></span>}
        {next?.slug ? (
          <a href={`/learn/${track!.id}/${next.slug}`} class="pg alignr"><span class="mono">Next →</span><span class="pt">{next.title}</span></a>
        ) : <span></span>}
      </nav>
    </article>

    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <div class="toc-inner">
          <div class="eyebrow">On this page</div>
          <ul>
            {toc.map((h) => (<li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Layout>

<style>
  .wrap { max-width: 1280px; margin-inline: auto; padding: 40px 32px 8px; display: grid; grid-template-columns: 236px minmax(0, 1fr) 200px; gap: 40px; align-items: start; }
  .side-inner, .toc-inner { position: sticky; top: 88px; }

  .side-track { display: block; font: 600 13px/1.3 'IBM Plex Sans', sans-serif; color: var(--text); padding-bottom: 12px; margin-bottom: 10px; border-bottom: 1px solid var(--rule); }
  .side-track:hover { color: var(--accent); text-decoration: none; }
  .side-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .sl { display: flex; align-items: flex-start; gap: 9px; padding: 7px 10px; margin: 0 -10px; border-radius: 6px; font: 400 13px/1.4 'IBM Plex Sans', sans-serif; color: var(--muted); }
  .sl:hover { color: var(--text); background: var(--paper); text-decoration: none; }
  .sl.current { color: var(--accent); font-weight: 500; background: var(--accent-wash); }
  .sl.dim { color: var(--faint); }
  .sl .node-dot { margin-top: 3px; flex: none; }

  .doc { min-width: 0; max-width: 720px; }
  .crumb { font-size: 11.5px; color: var(--faint); margin-bottom: 18px; }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--accent); text-decoration: none; }
  .crumb span { margin: 0 6px; }
  .doc h1 { font-size: clamp(28px, 4vw, 38px); letter-spacing: -.02em; }
  .dur { margin-top: 12px; font-size: 11px; color: var(--faint); letter-spacing: .04em; }
  .lede { margin-top: 14px; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .prose { margin-top: 30px; }

  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .pg { display: flex; flex-direction: column; gap: 4px; max-width: 48%; }
  .pg:hover { text-decoration: none; }
  .pg.alignr { text-align: right; margin-left: auto; }
  .pg .mono { font-size: 11px; color: var(--faint); }
  .pg .pt { font: 500 14px/1.25 'IBM Plex Sans', sans-serif; color: var(--text); }
  .pg:hover .pt { color: var(--accent); }

  .toc ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .toc li.sub { padding-left: 12px; }
  .toc a { font-size: 12.5px; line-height: 1.4; color: var(--muted); }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1080px) {
    .wrap { grid-template-columns: 220px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 800px) {
    .wrap { grid-template-columns: 1fr; gap: 24px; }
    .side { display: none; }
  }
</style>

<style is:global>
  .prose { font-size: 15.5px; line-height: 1.72; color: var(--text); }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 24px; letter-spacing: -.012em; margin-top: 1.9em; scroll-margin-top: 88px; }
  .prose h3 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 18.5px; margin-top: 1.6em; scroll-margin-top: 88px; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose ul, .prose ol { padding-left: 1.35em; }
  .prose li { margin-top: .4em; }
  .prose li::marker { color: var(--faint); }
  .prose strong { font-weight: 600; }
  .prose code { font-family: 'IBM Plex Mono', Menlo, monospace; font-size: .88em; background: var(--chip-bg); border: 1px solid var(--rule); border-radius: 4px; padding: 1px 5px; }
  .prose pre.astro-code { background: var(--code-bg) !important; border: 1px solid var(--rule); border-radius: 8px; padding: 15px 18px; overflow-x: auto; font-size: 13px; line-height: 1.62; }
  .prose pre.astro-code code { background: none; border: 0; padding: 0; font-size: inherit; }
  .prose blockquote { border-left: 3px solid var(--accent); padding: 4px 0 4px 16px; color: var(--muted); }
  .prose blockquote p { margin: 0; }
  .prose hr { border: 0; border-top: 1px solid var(--rule); margin: 2em 0; }
  .prose .callout { background: var(--paper); border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 8px; padding: 14px 18px; font-size: 14.5px; }
  .prose .callout p { margin: 0; }
  :root[data-theme="dark"] .prose pre.astro-code span { color: var(--shiki-dark) !important; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .prose pre.astro-code span { color: var(--shiki-dark) !important; }
  }
</style>
